---
import LordIcon from './LordIcon.astro';
---

<div class="fibramfer-logo" aria-hidden="true">
  <img
    src="/assets/logo-fibramfer.svg"
    alt=""
    class="fibramfer-logo-image block h-full w-full object-contain"
  />
  <svg
    class="fibramfer-logo-accent"
    viewBox="0 0 462 462"
    aria-hidden="true"
    focusable="false"
  >
    <path
      class="fibramfer-logo-accent-path"
      d="M221 150.002H150V221.002L221 150.002Z"
      fill="#FEE605"
    />
  </svg>
  <span class="fibramfer-home-tooltip" data-home-tooltip>
    <span class="fibramfer-home-tooltip-arrow" aria-hidden="true"></span>
    <span class="fibramfer-home-tooltip-icon" data-home-tooltip-icon aria-hidden="true">
      <span class="fibramfer-home-tooltip-icon-reveal" data-home-tooltip-reveal>
        <LordIcon
          src="/lordicon/system-outline-63-home-in-reveal.json"
          trigger="hover"
          state="in-reveal"
          target="a[aria-label='Home']"
          currentColor
          class="h-6 w-6"
        />
      </span>
      <span class="fibramfer-home-tooltip-icon-select" data-home-tooltip-select>
        <LordIcon
          src="/lordicon/system-outline-63-home-morph-select.json"
          trigger="hover"
          state="morph-select"
          currentColor
          class="h-6 w-6"
        />
      </span>
    </span>
  </span>
</div>
