---
import FibramferFloat from './FibramferFloat.astro';
import { sitePath } from '../lib/sitePath';

interface BlogPost {
  id: string;
  title: string;
  date: string;
  category?: string;
  image?: string;
  description?: string;
  contentHtml: string;
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const parsedDate = new Date(post.date);
const isoDate = Number.isNaN(parsedDate.getTime()) ? undefined : parsedDate.toISOString();
const displayDate = Number.isNaN(parsedDate.getTime())
  ? '—'
  : parsedDate.toLocaleDateString('pt-BR');
---

<article class="mx-auto max-w-3xl px-6 py-16">
  <a href={sitePath('/blog/')} class="font-medium text-primary-500 hover:underline decoration-accent-500 decoration-2 underline-offset-4">
    ← Voltar para o Blog
  </a>
  <h1 class="mt-6 mb-4 font-display text-4xl font-bold text-ink">{post.title}</h1>
  <div class="mb-8 flex items-center gap-4 text-sm text-text-secondary">
    <time datetime={isoDate}>{displayDate}</time>
    {post.category && <span>{post.category}</span>}
  </div>
  {post.image && (
    <img src={sitePath(post.image)} alt={post.title} class="mb-8 h-auto w-full rounded-lg border border-border" />
  )}
  {post.description && <p class="mb-8 text-lg text-text-secondary">{post.description}</p>}
  <div class="prose prose-lg max-w-none" set:html={post.contentHtml} />
  <FibramferFloat asset="f3" />
  <FibramferFloat asset="f3" mirror />
</article>
