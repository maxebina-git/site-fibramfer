---
import { getCollection, render } from 'astro:content';
import FibramferHistoria from './sections/FibramferHistoria.astro';
import Admin from './sections/Admin.astro';
import Security from './sections/Security.astro';
import CadeiraSuspensa from './sections/CadeiraSuspensa.astro';
import Contact from './sections/Contact.astro';
import Privacidade from './sections/Privacidade.astro';
import Termos from './sections/Termos.astro';
import BlogList from './BlogList.astro';
import BlogPostDrawer from './BlogPostDrawer.astro';
import DynamicBlogPost from './DynamicBlogPost.vue';
import NavigationDrawer from './NavigationDrawer.vue';
import { stripSiteBase } from '../lib/sitePath';

const blogPosts = import.meta.env.PROD
  ? []
  : (await getCollection('blog')).sort(
      (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
    );

const blogPostRoutes = blogPosts.map((post) => ({
  id: post.id,
  title: post.data.title,
}));

const renderedBlogPosts = await Promise.all(
  blogPosts.map(async (post) => ({
    post,
    Content: (await render(post)).Content,
  })),
);

const currentPath = stripSiteBase(Astro.url.pathname).replace(/\/+$/, '') || '/';
const currentBlogPostId = currentPath.startsWith('/blog/')
  ? currentPath.slice('/blog/'.length)
  : undefined;
const queryBlogPostId = currentPath === '/blog'
  ? Astro.url.searchParams.get('post')?.trim() || undefined
  : undefined;
const initialBlogPostId = queryBlogPostId
  ?? (blogPosts.some((post) => post.id === currentBlogPostId) ? currentBlogPostId : undefined);
---

<NavigationDrawer
  client:load
  initialPath={currentPath}
  initialPostId={initialBlogPostId}
  blogPosts={blogPostRoutes}
>
  <div slot="a-fibramfer"><FibramferHistoria /></div>
  <div slot="admin"><Admin /></div>
  <div slot="cadeira-suspensa"><CadeiraSuspensa /></div>
  <div slot="seguranca"><Security /></div>
  <div slot="blog"><BlogList posts={blogPosts} /></div>
  <div slot="contato"><Contact /></div>
  <div slot="privacidade"><Privacidade /></div>
  <div slot="termos"><Termos /></div>
  <div slot="blog-posts">
    {renderedBlogPosts.map(({ post, Content }) => (
      <div data-blog-post-id={post.id} hidden={post.id !== initialBlogPostId}>
        <BlogPostDrawer post={post} Content={Content} />
      </div>
    ))}
    {import.meta.env.PROD && <DynamicBlogPost client:load />}
  </div>
</NavigationDrawer>
