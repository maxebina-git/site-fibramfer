---
import FibramferFloat from './FibramferFloat.astro';
import { sitePath } from '../lib/sitePath';

interface BlogPost {
  id: string;
  title: string;
  date: string;
  image?: string;
  description?: string;
}

interface Props {
  posts: BlogPost[];
  class?: string;
}

const { posts, class: className = '' } = Astro.props;

function formatDate(value: string): string {
  const d = new Date(value);
  return Number.isNaN(d.getTime()) ? '—' : d.toLocaleDateString('pt-BR');
}
---

<section class={`pb-16 ${className}`}>
  <div class="mx-auto max-w-7xl px-6">
    <p class="mb-2 text-center font-body text-sm font-semibold uppercase tracking-[0.16em] text-accent-500">Novidades do setor</p>
    <h1 class="font-display text-4xl font-bold text-center text-ink mb-2">Blog e Novidades</h1>
    <p class="text-text-secondary mb-12 text-center">Fique por dentro das tendências do setor e atualizações técnicas.</p>
    <div
      id="blog-grid-root"
      class="grid grid-cols-1 md:grid-cols-3 gap-8"
    >
      {posts.map((post) => (
        <article class="bg-surface rounded-lg shadow-card border border-border overflow-hidden flex flex-col">
          {post.image && <img src={sitePath(post.image)} alt={post.title} class="h-48 w-full object-cover bg-surface-alt" />}
          {!post.image && <div class="h-48 bg-surface-alt"></div>}
          <div class="p-6 flex flex-col flex-1">
            <h2 class="font-display text-xl font-bold text-ink mb-2">
              <a href={sitePath(`/blog/${post.id}/`)} class="hover:underline decoration-accent-500 decoration-2 underline-offset-4">{post.title}</a>
            </h2>
            {post.description && <p class="text-text-secondary text-sm mb-4">{post.description}</p>}
            <time class="text-text-secondary text-sm mt-auto" datetime={post.date}>{formatDate(post.date)}</time>
          </div>
        </article>
      ))}
      {posts.length === 0 && <p class="text-text-secondary msg-empty-blog">Nenhum post publicado ainda.</p>}
    </div>
  </div>
  <FibramferFloat asset="f2" />
  <FibramferFloat asset="f2" mirror />
</section>
