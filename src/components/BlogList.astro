---
import FibramferFloat from './FibramferFloat.astro';

interface BlogPost {
  id: string;
  data: {
    title: string;
    description?: string;
    image?: string;
    date: Date;
  };
}

interface Props {
  posts: BlogPost[];
  class?: string;
}

const { posts, class: className = '' } = Astro.props;

const allPosts = posts;
---

<section class={`pb-16 ${className}`}>
  <div class="mx-auto max-w-7xl px-6">
    <p class="mb-2 text-center font-body text-sm font-semibold uppercase tracking-[0.16em] text-accent-500">Novidades do setor</p>
    <h1 class="font-display text-4xl font-bold text-center text-ink mb-2">Blog e Novidades</h1>
    <p class="text-text-secondary mb-12 text-center">Fique por dentro das tendências do setor e atualizações técnicas.</p>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8" data-admin-loaded="false" id="blog-grid-root">
      {allPosts.map((post: any) => (
        <article class="bg-surface rounded-lg shadow-card border border-border overflow-hidden flex flex-col">
          {(post.data ? post.data.image : post.image) && <img src={post.data ? post.data.image : post.image} alt={post.data ? post.data.title : post.title} class="h-48 w-full object-cover bg-surface-alt" />}
          {!(post.data ? post.data.image : post.image) && <div class="h-48 bg-surface-alt"></div>}
          <div class="p-6 flex flex-col flex-1">
            <h2 class="font-display text-xl font-bold text-ink mb-2">
              <a href={`/blog/${post.id}/`} class="hover:underline decoration-accent-500 decoration-2 underline-offset-4">{post.data ? post.data.title : post.title}</a>
            </h2>
            <p class="text-text-secondary text-sm mb-4">{post.data ? post.data.description : (post.content ? post.content.substring(0,120)+'...' : '')}</p>
            <time class="text-text-secondary text-sm mt-auto" datetime={post.data ? post.data.date.toISOString() : post.date}>
              {(post.data ? post.data.date : new Date(post.date || Date.now())).toLocaleDateString('pt-BR')}
            </time>
          </div>
        </article>
      ))}
      {allPosts.length === 0 && <p class="text-text-secondary msg-empty-blog" style="display:none;">Nenhum post publicado ainda.</p>}
    </div>
  </div>
  <FibramferFloat asset="f2" />
  <FibramferFloat asset="f2" mirror />

  <script is:inline>
    (function(){
      var grid=document.querySelector('#blog-grid-root');
      if(!grid||grid.getAttribute('data-admin-loaded')==='true') return;
      fetch('/api/admin.php?action=list').then(function(r){return r.json();}).then(function(d){
        if(d.posts&&d.posts.length&&grid.getAttribute('data-admin-loaded')==='false'){
          d.posts.forEach(function(p){
            if(!p)return; var pid=p.id||(p.data&&p.data.id)||''; if(!pid)return;
            var article=document.createElement('article'); article.className='bg-surface rounded-lg shadow-card border border-border overflow-hidden flex flex-col';
            var imgWrap=document.createElement('div'); imgWrap.className=(p.image||(p.data&&p.data.image))?'':'h-48 bg-surface-alt';
            if(p.image||(p.data&&p.data.image)){var img=document.createElement('img');img.src=p.image||(p.data&&p.data.image);img.alt=(p.title||(p.data&&p.data.title))||'';img.className='h-48 w-full object-cover bg-surface-alt';imgWrap.appendChild(img);}
            article.appendChild(imgWrap); var body=document.createElement('div'); body.className='p-6 flex flex-col flex-1';
            var h2=document.createElement('h2'); h2.className='font-display text-xl font-bold text-ink mb-2';
            var a=document.createElement('a'); a.href='/blog/'+pid+'/'; a.className='hover:underline decoration-accent-500 decoration-2 underline-offset-4'; a.textContent=(p.title||(p.data&&p.data.title))||''; h2.appendChild(a); body.appendChild(h2);
            var time=document.createElement('time'); time.className='text-text-secondary text-sm mt-auto'; time.setAttribute('datetime',p.date||(p.data&&p.data.date)||''); time.textContent=new Date(p.date||(p.data&&p.data.date)||Date.now()).toLocaleDateString('pt-BR'); body.appendChild(time); article.appendChild(body); grid.appendChild(article);
          }); grid.setAttribute('data-admin-loaded','true'); var emptyMsg=grid.querySelector('.msg-empty-blog'); if(emptyMsg) emptyMsg.style.display='none';
        }
      }).catch(function(){});
    })();
  </script>
</section>
