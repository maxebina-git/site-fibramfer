---
import { Button, Card, Section } from 'ds-grupo-rkb';
import SecuritySupport from '../SecuritySupport.vue';
import SecurityCurveSlider from '../SecurityCurveSlider.astro';
import LordIcon from '../LordIcon.astro';
import FibramferFloat from '../FibramferFloat.astro';

const commitments = [
  {
    title: 'CA VÁLIDO E RASTREÁVEL',
    text: 'Todos os produtos possuem CA emitido pelo Ministério do Trabalho, com número gravado no equipamento e validade atualizada.',
  },
  {
    title: 'TESTES DE CARGA RIGOROSOS',
    text: 'Cada lote passa por testes que excedem os requisitos da norma, garantindo resistência superior em condições reais.',
  },
  {
    title: 'RASTREABILIDADE COMPLETA',
    text: 'Do recebimento da matéria-prima à entrega final, cada etapa é documentada e auditável.',
  },
  {
    title: 'SUPORTE TÉCNICO ESPECIALIZADO',
    text: 'Equipe técnica disponível para orientar sobre uso correto, manutenção e descarte dos equipamentos.',
  },
];
---

<Section id="seguranca-hero" size="none" tone="surface" class="mb-12">
  <div class="mx-auto grid max-w-7xl grid-cols-1 items-center gap-12 px-4 md:grid-cols-2 md:px-8">
    <div>
      <p class="mb-4 font-body text-sm font-semibold uppercase tracking-[0.16em] text-accent-500">Segurança Fibramfer</p>
      <h1 class="mb-6 font-display text-4xl font-black uppercase leading-tight text-primary-500 md:text-6xl">
        CONFORMIDADE TOTAL COM A NR-18: SEGURANÇA QUE SALVA VIDAS
      </h1>
      <p class="mb-8 font-body text-lg leading-relaxed text-text-secondary">
        Todos os equipamentos Fibramfer atendem rigorosamente à Portaria 13/2002 do Ministério do Trabalho, com Certificado de Aprovação (CA) válido e rastreável.
      </p>
      <div class="flex flex-col gap-4 sm:flex-row">
        <Button
          id="security-documentation-cta"
          variant="primary"
          size="lg"
          as="a"
          href="/contato/"
          class="bg-accent-500 text-ink hover:bg-accent-600 active:bg-accent-600"
        >
          Solicitar Documentação
          <LordIcon
            src="/lordicon/system-outline-3090-mail-open-document-hover-pinch.json"
            trigger="hover"
            state="hover-pinch"
            target="#security-documentation-cta"
            currentColor
            class="h-5 w-5 shrink-0"
          />
        </Button>
        <Button id="security-whatsapp-cta" variant="secondary" size="lg" as="a" href="/contato/">
          Falar no WhatsApp
          <LordIcon
            src="/lordicon/system-outline-4073-email-hover-pinch.json"
            trigger="hover"
            state="hover-pinch"
            target="#security-whatsapp-cta"
            class="h-5 w-5 shrink-0"
          />
        </Button>
      </div>
    </div>
    <SecurityCurveSlider />
  </div>
</Section>

<Section id="compromissos-nr18" size="none" tone="surface-alt" class="mb-12 py-6">
  <div class="mx-auto grid max-w-7xl grid-cols-1 gap-12 px-4 md:grid-cols-5 md:px-8">
    <div class="md:col-span-2">
      <p class="mb-4 font-body text-sm font-semibold uppercase tracking-[0.16em] text-accent-500">Compromisso técnico</p>
      <h2 class="mb-6 font-display text-3xl font-extrabold uppercase leading-tight text-primary-500 md:text-4xl">
        POR QUE A NR-18 IMPORTA?
      </h2>
      <p class="font-body text-base leading-relaxed text-text-secondary">
        A NR-18 é a principal legislação brasileira para segurança no trabalho na construção civil. Ela define os requisitos mínimos para proteção de trabalhadores em altura, incluindo o uso obrigatório de EPIs certificados. A Fibramfer não apenas cumpre a norma — nossos produtos são desenvolvidos para atender e superar esses requisitos.
      </p>
    </div>
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 md:col-span-3">
      {commitments.map((commitment) => (
        <Card
          padding="md"
          class="border-t-4 border-t-accent-500 bg-surface shadow-card group hover:-translate-y-0.5 hover:border-ink/30 hover:shadow-elevation-3 transition-all duration-300"
        >
          <div class="flex items-center gap-3 mb-2">
            <h3 class="font-display text-xl font-bold uppercase leading-tight text-primary-500">
              {commitment.title}
            </h3>
            <div class="h-2 min-w-0 flex-1 overflow-hidden rounded-full" aria-hidden="true">
              <div class="h-full w-1/3 rounded-full bg-fibra-gold-500 transition-all duration-300 ease-in-out group-hover:w-full"></div>
            </div>
          </div>
          <p class="font-body text-sm leading-relaxed text-text-secondary">{commitment.text}</p>
        </Card>
      ))}
    </div>
  </div>
</Section>

<Section id="documentacao-suporte" size="none" tone="surface" class="mb-12">
  <div class="mx-auto max-w-5xl px-4 md:px-8">
    <div class="mx-auto mb-12 max-w-3xl text-center">
      <p class="mb-4 font-body text-sm font-semibold uppercase tracking-[0.16em] text-accent-500">Acesso especializado</p>
      <h2 class="mb-4 font-display text-3xl font-extrabold uppercase leading-tight text-primary-500 md:text-4xl">
        DOCUMENTAÇÃO E SUPORTE TÉCNICO
      </h2>
      <p class="font-body text-base leading-relaxed text-text-secondary">
        Consulte os documentos disponíveis e encontre respostas para as principais dúvidas sobre certificação, uso e manutenção.
      </p>
    </div>
    <SecuritySupport client:load />
  </div>
</Section>

<Section id="seguranca-cta" size="none" tone="surface" class="mb-12">
  <div class="mx-auto max-w-5xl rounded-lg bg-surface-alt px-4 py-16 text-ink md:px-8 md:py-20">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="mb-6 font-display text-3xl font-extrabold uppercase leading-tight text-accent-500 md:text-5xl">
        SUA EMPRESA EM CONFORMIDADE TOTAL COMEÇA AQUI
      </h2>
      <p class="mb-8 font-body text-lg leading-relaxed text-text-secondary">
        Não arrisque a segurança da sua equipe com equipamentos sem certificação. Fale com nossos especialistas.
      </p>
      <div class="flex flex-col justify-center gap-4 sm:flex-row">
        <Button
          id="security-quote-cta"
          variant="primary"
          size="lg"
          as="a"
          href="/contato/"
          class="bg-accent-500 text-ink hover:bg-accent-600 active:bg-accent-600"
        >
          Solicitar Orçamento Agora
          <LordIcon
            src="/lordicon/system-outline-3104-thumbs-up-down-hover-pinch.json"
            trigger="hover"
            state="hover-pinch"
            target="#security-quote-cta"
            currentColor
            class="h-5 w-5 shrink-0"
          />
        </Button>
        <Button
          id="security-final-whatsapp-cta"
          variant="secondary"
          size="lg"
          as="a"
          href="/contato/"
        >
          Falar no WhatsApp
          <LordIcon
            src="/lordicon/system-outline-4073-email-hover-pinch.json"
            trigger="hover"
            state="hover-pinch"
            target="#security-final-whatsapp-cta"
            class="h-5 w-5 shrink-0"
          />
        </Button>
      </div>
    </div>
  </div>
</Section>

<FibramferFloat asset="f1" />
<FibramferFloat asset="f1" mirror />
