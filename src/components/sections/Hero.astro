---
import { Button } from 'ds-grupo-rkb';
import FibramferF1Float from '../FibramferF1Float.astro';
const { class: className = '' } = Astro.props;
---

<section class={`py-20 ${className}`}>
  <div class="text-center max-w-3xl mx-auto">
    <h1 class="font-display text-4xl md:text-5xl font-bold mb-6 text-ink">A Fibramfer</h1>
    <p class="text-lg text-text-secondary mb-8">
      Referência em soluções de fibra, unindo tecnologia de ponta e compromisso com a excelência para entregar a máxima performance em cada projeto.
    </p>
    <Button variant="primary" size="lg" as="a" href="/a-fibramfer/">Conheça nossa história</Button>
    <FibramferF1Float />
  </div>
</section>
