---
import { Button, Input, Textarea } from 'ds-grupo-rkb';
import FibramferFloat from '../FibramferFloat.astro';
import LordIcon from '../LordIcon.astro';
const { class: className = '' } = Astro.props;
---

<section class={`relative bg-surface py-12 text-ink md:py-16 ${className}`}>
  <div class="mx-auto max-w-6xl px-4 md:px-8">
    <header class="mx-auto max-w-4xl text-center">
      <p class="mb-2 font-body text-sm font-semibold uppercase tracking-[0.16em] text-accent-500">FIBRAMFER - INDÚSTRIA E COM. LTDA</p>
      <h1 class="font-display text-4xl font-bold text-center text-ink mb-2">Contato</h1>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-x-4 gap-y-2 font-body text-base text-text-secondary">
        <a class="transition-colors hover:text-ink" href="tel:+551155622727">11 5562-2727</a>
        <span aria-hidden="true">|</span>
        <a class="transition-colors hover:text-ink" href="https://wa.me/551155622727" target="_blank" rel="noreferrer">WhatsApp</a>
        <span aria-hidden="true">|</span>
        <a class="transition-colors hover:text-ink" href="mailto:fibramfer@fibramfer.com.br">fibramfer@fibramfer.com.br</a>
      </div>
    </header>

    <div class="mx-auto mt-14 grid max-w-4xl gap-8 md:grid-cols-[minmax(0,1.2fr)_minmax(0,0.8fr)] md:items-center">
      <div>
        <h2 class="max-w-2xl font-display text-3xl font-bold leading-tight text-ink md:text-4xl">
          Segurança em obra começa no planejamento
        </h2>
        <p class="mt-6 max-w-2xl font-body text-lg leading-relaxed text-text-secondary">
          Na Fibramfer, desenvolvemos soluções certificadas para trabalho em altura, com engenharia, resistência e segurança em cada detalhe.
        </p>
      </div>

      <div class="bg-surface p-6 rounded-lg shadow-card border border-border group hover:-translate-y-0.5 hover:border-ink/30 hover:shadow-elevation-3 transition-all duration-300">
        <div class="flex items-center gap-3 mb-2">
          <h3 class="whitespace-nowrap font-display text-xl font-bold text-ink">NOSSA SEDE</h3>
          <div class="h-2 min-w-0 flex-1 overflow-hidden rounded-full" aria-hidden="true">
            <div class="h-full w-1/3 rounded-full bg-fibra-gold-500 transition-all duration-300 ease-in-out group-hover:w-full"></div>
          </div>
        </div>
        <address class="font-body text-base leading-relaxed text-text-secondary not-italic">
          Rua José Neves, 1035<br />
          Vila São Paulo<br />
          CEP: 04650-142<br />
          São Paulo/SP
        </address>
      </div>
    </div>

    <form class="mx-auto mt-12 max-w-3xl rounded-lg border border-border bg-surface p-6 shadow-card md:p-8" method="post">
      <div class="grid grid-cols-1 gap-6">
        <div class="flex flex-col gap-1.5">
          <label for="contact-name" class="text-sm font-medium text-ink">Nome</label>
          <Input id="contact-name" name="name" type="text" placeholder="Seu nome" required />
        </div>

        <div class="flex flex-col gap-1.5">
          <label for="contact-whatsapp" class="text-sm font-medium text-ink">WhatsApp</label>
          <Input id="contact-whatsapp" name="whatsapp" type="tel" placeholder="(11) 99999-9999" required />
        </div>

        <div class="flex flex-col gap-1.5">
          <label for="contact-email" class="text-sm font-medium text-ink">Email</label>
          <Input id="contact-email" name="email" type="email" placeholder="seu@email.com.br" required />
        </div>

        <div class="flex flex-col gap-1.5">
          <label for="contact-message" class="text-sm font-medium text-ink">Mensagem</label>
          <Textarea id="contact-message" name="message" rows={5} placeholder="Escreva sua mensagem" required />
        </div>
      </div>

      <Button id="contact-submit-cta" variant="primary" size="lg" type="submit" fullWidth class="mt-6">
        <LordIcon
          src="/lordicon/system-outline-3090-mail-open-document-hover-pinch.json"
          trigger="hover"
          state="hover-pinch"
          target="#contact-submit-cta"
          currentColor
          class="h-5 w-5 shrink-0"
        />
        Enviar mensagem
      </Button>
    </form>

    <div class="sr-only" aria-live="polite">Formulário de contato da Fibramfer</div>

    <FibramferFloat asset="f3" />
    <FibramferFloat asset="f3" mirror />
  </div>
</section>
