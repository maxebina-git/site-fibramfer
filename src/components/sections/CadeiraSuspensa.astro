---
import { Button } from 'ds-grupo-rkb';
import FibramferFloat from '../FibramferFloat.astro';
import HeroCurveSlider from '../HeroCurveSlider.astro';
---

<div class="text-center mb-12">
  <h2 class="font-display text-3xl font-bold mb-4 text-ink">Cadeira Suspensa</h2>
  <p class="text-text-secondary">Este equipamento atende as normas do ministério do trabalho - NR18 Portaria 13 de 09.07.2002.</p>
</div>
<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
  <div id="cs-card-1" onclick="const c=this; if(!c.classList.contains('cs-expanded')) c.classList.add('cs-top'); setTimeout(() => { c.classList.toggle('cs-expanded'); const btn=c.querySelector('button'); if(btn) btn.innerText = btn.innerText === 'Ver detalhes' ? 'Ocultar detalhes' : 'Ver detalhes'; if(!c.classList.contains('cs-expanded')) setTimeout(() => c.classList.remove('cs-top'), 500); }, 50);" class="bg-surface p-6 rounded-lg shadow-card border border-border hover:-translate-y-0.5 hover:border-ink/30 hover:shadow-elevation-3 transition-all duration-300 ease-in-out relative overflow-visible w-full cursor-pointer cs-anim cs-delay-1">
    <div class="flex h-full gap-4 items-stretch">
      <div class="w-[393px] max-w-full flex-shrink-0 self-stretch">
        <HeroCurveSlider
      slides={[
        { src: '/assets/cadeira-suspensa/001.webp', alt: 'Cadeira Suspensa 1 - vista 1' },
        { src: '/assets/cadeira-suspensa/002.webp', alt: 'Cadeira Suspensa 1 - vista 2' },
        { src: '/assets/cadeira-suspensa/003.webp', alt: 'Cadeira Suspensa 1 - vista 3' },
      ]}
      label="Galeria 1"
      autoplayMs={3000}
      idPrefix="cs1"
    />
    <h3 id="cs1-h3" class="font-display text-xl font-bold mb-2 text-ink transition-all duration-300">Cadeira Suspensa 1</h3>
    <p id="cs1-desc" class="text-text-secondary mb-4 transition-all duration-300">Descrição detalhada do produto.</p>
    <Button variant="secondary" size="sm">Ver detalhes</Button>
    </div>
    <div class="h-full w-full bg-fibra-gold-500 rounded-lg"></div>
    </div>
  </div>
  <div id="cs-card-2" onclick="const c=this; if(!c.classList.contains('cs-expanded')) c.classList.add('cs-top'); setTimeout(() => { c.classList.toggle('cs-expanded'); const btn=c.querySelector('button'); if(btn) btn.innerText = btn.innerText === 'Ver detalhes' ? 'Ocultar detalhes' : 'Ver detalhes'; if(!c.classList.contains('cs-expanded')) setTimeout(() => c.classList.remove('cs-top'), 500); }, 50);" class="bg-surface p-6 rounded-lg shadow-card border border-border hover:-translate-y-0.5 hover:border-ink/30 hover:shadow-elevation-3 transition-all duration-300 ease-in-out relative overflow-visible w-full cursor-pointer cs-anim cs-delay-2">
    <div class="flex h-full gap-4 items-stretch">
      <div class="w-[393px] max-w-full flex-shrink-0 self-stretch">
        <HeroCurveSlider
      slides={[
        { src: '/assets/cadeira-suspensa/004.webp', alt: 'Cadeira Suspensa 2 - vista 1' },
        { src: '/assets/cadeira-suspensa/005.webp', alt: 'Cadeira Suspensa 2 - vista 2' },
        { src: '/assets/cadeira-suspensa/006.webp', alt: 'Cadeira Suspensa 2 - vista 3' },
      ]}
      label="Galeria 2"
      autoplayMs={3250}
      idPrefix="cs2"
    />
    <h3 id="cs2-h3" class="font-display text-xl font-bold mb-2 text-ink transition-all duration-300">Cadeira Suspensa 2</h3>
    <p id="cs2-desc" class="text-text-secondary mb-4 transition-all duration-300">Descrição detalhada do produto.</p>
    <Button variant="secondary" size="sm">Ver detalhes</Button>
    </div>
    <div class="h-full w-full bg-fibra-gold-500 rounded-lg"></div>
    </div>
  </div>
  <div id="cs-card-3" onclick="const c=this; if(!c.classList.contains('cs-expanded')) c.classList.add('cs-top'); setTimeout(() => { c.classList.toggle('cs-expanded'); const btn=c.querySelector('button'); if(btn) btn.innerText = btn.innerText === 'Ver detalhes' ? 'Ocultar detalhes' : 'Ver detalhes'; if(!c.classList.contains('cs-expanded')) setTimeout(() => c.classList.remove('cs-top'), 500); }, 50);" class="bg-surface p-6 rounded-lg shadow-card border border-border hover:-translate-y-0.5 hover:border-ink/30 hover:shadow-elevation-3 transition-all duration-300 ease-in-out relative overflow-visible w-full cursor-pointer cs-anim cs-delay-3">
    <div class="flex h-full gap-4 items-stretch">
      <div class="w-[393px] max-w-full flex-shrink-0 self-stretch">
        <HeroCurveSlider
      slides={[
        { src: '/assets/cadeira-suspensa/007.webp', alt: 'Cadeira Suspensa 3 - vista 1' },
        { src: '/assets/cadeira-suspensa/008.webp', alt: 'Cadeira Suspensa 3 - vista 2' },
      ]}
      label="Galeria 3"
      autoplayMs={3500}
      idPrefix="cs3"
    />
    <h3 id="cs3-h3" class="font-display text-xl font-bold mb-2 text-ink transition-all duration-300">Cadeira Suspensa 3</h3>
    <p id="cs3-desc" class="text-text-secondary mb-4 transition-all duration-300">Descrição detalhada do produto.</p>
    <Button variant="secondary" size="sm">Ver detalhes</Button>
    </div>
    <div class="h-full w-full bg-fibra-gold-500 rounded-lg"></div>
    </div>
  </div>
</div>
<FibramferFloat asset="f2" />
<style>
  @keyframes fadeSlideUp { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: translateY(0); } }
  @keyframes fadeSlideDown { from { opacity: 1; transform: translateY(0); } to { opacity: 0; transform: translateY(24px); } }
  .cs-anim { animation: fadeSlideUp 0.6s ease-out both; }
  .cs-hide { animation: fadeSlideDown 0.5s ease-out both; }
  .cs-delay-1 { animation-delay: 0s; }
  .cs-delay-2 { animation-delay: 0.15s; }
  .cs-delay-3 { animation-delay: 0.3s; }
  .cs-top { z-index: 100 !important; }
  #cs-card-1 { position: relative; z-index: 50; transition: width 0.5s ease-in-out, box-shadow 0.3s ease; will-change: width; }
  #cs-card-1.cs-expanded { width: calc(300% + 4rem); }
  #cs-card-2 { position: relative; z-index: 60; transition: width 0.5s ease-in-out, box-shadow 0.3s ease, margin-left 0.5s ease-in-out; will-change: width, margin-left; }
  #cs-card-2.cs-expanded { width: calc(300% + 4rem); margin-left: calc(-100% - 2rem); }
  #cs-card-3 { position: relative; z-index: 70; transition: width 0.5s ease-in-out, box-shadow 0.3s ease, margin-left 0.5s ease-in-out; will-change: width, margin-left; }
  #cs-card-3.cs-expanded { width: calc(300% + 4rem); margin-left: calc(-200% - 4rem); }
</style>
<script>
  (function(){
    var cards = document.querySelectorAll('#cs-card-1, #cs-card-2, #cs-card-3');
    function reveal(){ cards.forEach(function(c){ c.classList.remove('cs-hide'); c.classList.add('cs-anim'); }); }
    function hide(){ cards.forEach(function(c){ c.classList.remove('cs-anim'); c.classList.add('cs-hide'); }); }
    window.addEventListener('fibramfer:drawer-open', reveal);
    window.addEventListener('fibramfer:drawer-close', hide);
  })();
</script>
<FibramferFloat asset="f2" mirror />
