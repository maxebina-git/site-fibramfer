---
import { Button } from 'ds-grupo-rkb';
import FibramferFloat from '../FibramferFloat.astro';
import HeroCurveSlider from '../HeroCurveSlider.astro';
---

<div class="text-center mb-12">
  <h2 class="font-display text-3xl font-bold mb-4 text-ink">Cadeira Suspensa</h2>
  <p class="text-text-secondary">Este equipamento atende as normas do ministério do trabalho - NR18 Portaria 13 de 09.07.2002.</p>
</div>
<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
  <div class="bg-surface p-6 rounded-lg shadow-card border border-border hover:-translate-y-0.5 hover:border-ink/30 hover:shadow-elevation-3 transition-all duration-300 ease-in-out">
    <div class="h-[240px] w-full">
    <HeroCurveSlider
      slides={[
        { src: '/assets/cadeira-suspensa/001.webp', alt: 'Cadeira Suspensa 1 - vista 1' },
        { src: '/assets/cadeira-suspensa/002.webp', alt: 'Cadeira Suspensa 1 - vista 2' },
        { src: '/assets/cadeira-suspensa/003.webp', alt: 'Cadeira Suspensa 1 - vista 3' },
      ]}
      label="Galeria 1"
      autoplayMs={3000}
      idPrefix="cs1"
    />
    </div>
    <h3 id="cs1-h3" class="font-display text-xl font-bold mb-2 text-ink">Cadeira Suspensa 1</h3>
    <p id="cs1-desc" class="text-text-secondary mb-4">Descrição detalhada do produto.</p>
    <Button variant="secondary" size="sm" onclick="document.getElementById('cs1-h3').classList.toggle('hidden'); document.getElementById('cs1-desc').classList.toggle('hidden'); this.innerText = this.innerText === 'Ver Detalhes' ? 'Ocultar detalhes' : 'Ver Detalhes';">Ver Detalhes</Button>
  </div>
  <div class="bg-surface p-6 rounded-lg shadow-card border border-border hover:-translate-y-0.5 hover:border-ink/30 hover:shadow-elevation-3 transition-all duration-300 ease-in-out">
    <HeroCurveSlider
      slides={[
        { src: '/assets/cadeira-suspensa/004.webp', alt: 'Cadeira Suspensa 2 - vista 1' },
        { src: '/assets/cadeira-suspensa/005.webp', alt: 'Cadeira Suspensa 2 - vista 2' },
        { src: '/assets/cadeira-suspensa/006.webp', alt: 'Cadeira Suspensa 2 - vista 3' },
      ]}
      label="Galeria 2"
      autoplayMs={3250}
      idPrefix="cs2"
    />
    <h3 class="font-display text-xl font-bold mb-2 text-ink">Cadeira Suspensa 2</h3>
    <p class="text-text-secondary mb-4">Descrição detalhada do produto.</p>
    <Button variant="secondary" size="sm">Ver Detalhes</Button>
  </div>
  <div class="bg-surface p-6 rounded-lg shadow-card border border-border hover:-translate-y-0.5 hover:border-ink/30 hover:shadow-elevation-3 transition-all duration-300 ease-in-out">
    <HeroCurveSlider
      slides={[
        { src: '/assets/cadeira-suspensa/007.webp', alt: 'Cadeira Suspensa 3 - vista 1' },
        { src: '/assets/cadeira-suspensa/008.webp', alt: 'Cadeira Suspensa 3 - vista 2' },
      ]}
      label="Galeria 3"
      autoplayMs={3500}
      idPrefix="cs3"
    />
    <h3 class="font-display text-xl font-bold mb-2 text-ink">Cadeira Suspensa 3</h3>
    <p class="text-text-secondary mb-4">Descrição detalhada do produto.</p>
    <Button variant="secondary" size="sm">Ver Detalhes</Button>
  </div>
</div>
<FibramferFloat asset="f2" />
<FibramferFloat asset="f2" mirror />
