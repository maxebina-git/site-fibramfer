---
import { Section, Button } from 'ds-grupo-rkb';
import FibramferFloat from '../FibramferFloat.astro';
import HeroCurveSlider from '../HeroCurveSlider.astro';
import LordIcon from '../LordIcon.astro';
---

<div class="text-center mb-12">
    <p class="mb-2 font-body text-sm font-semibold uppercase tracking-[0.16em] text-accent-500">Equipamentos de segurança</p>
    <h1 class="font-display text-4xl font-bold text-center text-ink mb-2">Cadeira Suspensa</h1>
  <p class="text-text-secondary">Este equipamento atende as normas do ministério do trabalho - NR18 Portaria 13 de 09.07.2002.</p>
  </div>
<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
  <div id="cs-card-1" data-cadeira-card class="bg-surface p-6 rounded-lg shadow-card border border-border hover:-translate-y-0.5 hover:border-ink/30 hover:shadow-elevation-3 transition-all duration-300 ease-in-out relative overflow-visible w-full">
    <div class="flex h-full gap-4 items-stretch">
      <div class="w-[393px] max-w-full flex-shrink-0 self-stretch">
        <div data-card-toggle class="cursor-pointer" role="button" tabindex="0" aria-label="Abrir detalhes da Cadeira Suspensa 1">
        <HeroCurveSlider
      slides={[
        { src: '/assets/cadeira-suspensa/001.webp', alt: 'Cadeira Suspensa 1 - vista 1' },
        { src: '/assets/cadeira-suspensa/002.webp', alt: 'Cadeira Suspensa 1 - vista 2' },
        { src: '/assets/cadeira-suspensa/003.webp', alt: 'Cadeira Suspensa 1 - vista 3' },
      ]}
      label="Galeria 1"
      autoplayMs={3000}
      idPrefix="cs1"
    />
        </div>
    <h3 id="cs1-h3" class="cs-card-title-source font-display text-xl font-bold mb-2 text-ink transition-all duration-300">Indicação de Uso</h3>
    <p id="cs1-desc" class="cs-card-subtitle-source text-text-secondary mb-4 transition-all duration-300">Versatilidade e segurança para serviços em altura</p>
    <Button variant="secondary" size="sm" data-card-toggle class="cs-card-button-source">Ver detalhes</Button>
    </div>
    <div class="h-full w-full bg-surface-alt rounded-lg p-4 relative overflow-hidden cs-card-details" aria-hidden="true"><h3 class="absolute inset-x-4 top-4 m-0 font-display text-xl font-bold text-ink cs-card-title-detail">Indicação de Uso</h3><p class="absolute inset-x-4 top-12 m-0 text-text-secondary cs-card-subtitle-detail">Versatilidade e segurança para serviços em altura</p>            <p class="absolute inset-x-4 top-24 bottom-16 m-0 text-sm font-medium text-ink leading-relaxed cs-card-details-text">Projetada para serviços seguros em altura ou profundidade, como pintura, reparos, manutenção e lavagem em edificações, torres, viadutos e estruturas complexas. Garante ergonomia e estabilidade na movimentação vertical descendente, sendo a escolha ideal para obras que exigem máxima conformidade, eficiência operacional e segurança absoluta para o trabalhador.</p>
            <Button variant="secondary" size="sm" data-card-toggle class="cs-card-button-detail absolute left-4 bottom-4">Ver detalhes</Button>
            <div class="cs-quick-nav absolute right-4 bottom-4 flex items-center gap-5 opacity-0 transition-opacity duration-300">
              <span class="text-[10px] font-bold text-text-secondary uppercase tracking-widest whitespace-nowrap">Ir para:</span>
              <div class="flex items-center gap-1.5">
                <img src="/assets/illustrations/manutencao-v2.svg" class="w-7 h-7" alt="" />
                <button data-goto="cs-card-2" class="cursor-pointer text-xs font-bold text-primary-500 hover:text-accent-500 transition-colors uppercase underline-offset-4 hover:underline">Manutenção e Inspeção</button>
              </div>
              <div class="flex items-center gap-1.5">
                <img src="/assets/illustrations/carga-v2.svg" class="w-7 h-7" alt="" />
                <button data-goto="cs-card-3" class="cursor-pointer text-xs font-bold text-primary-500 hover:text-accent-500 transition-colors uppercase underline-offset-4 hover:underline">Capacidade de Carga</button>
              </div>
            </div>
          </div>
    </div>
  </div>
  <div id="cs-card-2" data-cadeira-card class="bg-surface p-6 rounded-lg shadow-card border border-border hover:-translate-y-0.5 hover:border-ink/30 hover:shadow-elevation-3 transition-all duration-300 ease-in-out relative overflow-visible w-full">
    <div class="flex h-full gap-4 items-stretch">
      <div class="w-[393px] max-w-full flex-shrink-0 self-stretch">
        <div data-card-toggle class="cursor-pointer" role="button" tabindex="0" aria-label="Abrir detalhes da Cadeira Suspensa 2">
        <HeroCurveSlider
      slides={[
        { src: '/assets/cadeira-suspensa/004.webp', alt: 'Cadeira Suspensa 2 - vista 1' },
        { src: '/assets/cadeira-suspensa/005.webp', alt: 'Cadeira Suspensa 2 - vista 2' },
        { src: '/assets/cadeira-suspensa/006.webp', alt: 'Cadeira Suspensa 2 - vista 3' },
      ]}
      label="Galeria 2"
      autoplayMs={3250}
      idPrefix="cs2"
    />
        </div>
    <h3 id="cs2-h3" class="cs-card-title-source font-display text-xl font-bold mb-2 text-ink transition-all duration-300">Manutenção e Inspeção</h3>
    <p id="cs2-desc" class="cs-card-subtitle-source text-text-secondary mb-4 transition-all duration-300">Integridade garantida antes e após cada uso</p>
    <Button variant="secondary" size="sm" data-card-toggle class="cs-card-button-source">Ver detalhes</Button>
    </div>
    <div class="h-full w-full bg-surface-alt rounded-lg p-4 relative overflow-hidden cs-card-details" aria-hidden="true"><h3 class="absolute inset-x-4 top-4 m-0 font-display text-xl font-bold text-ink cs-card-title-detail">Manutenção e Inspeção</h3><p class="absolute inset-x-4 top-12 m-0 text-text-secondary cs-card-subtitle-detail">Integridade garantida antes e após cada uso</p><p class="absolute inset-x-4 top-24 bottom-16 m-0 text-sm font-medium text-ink leading-relaxed cs-card-details-text">A segurança no trabalho exige verificação rigorosa do estado do equipamento antes e após cada utilização diária. Modificações, adaptações ou reparos não autorizados são estritamente proibidos. Qualquer intervenção técnica deve ser realizada exclusivamente pelo fabricante, garantindo a integridade estrutural e a validade do Certificado de Aprovação (CA).</p><Button variant="secondary" size="sm" data-card-toggle class="cs-card-button-detail absolute left-4 bottom-4">Ver detalhes</Button>
            <div class="cs-quick-nav absolute right-4 bottom-4 flex items-center gap-5 opacity-0 transition-opacity duration-300">
              <span class="text-[10px] font-bold text-text-secondary uppercase tracking-widest whitespace-nowrap">Ir para:</span>
              <div class="flex items-center gap-1.5">
                <img src="/assets/illustrations/uso-v2.svg" class="w-7 h-7" alt="" />
                <button data-goto="cs-card-1" class="cursor-pointer text-xs font-bold text-primary-500 hover:text-accent-500 transition-colors uppercase underline-offset-4 hover:underline">Indicação de Uso</button>
              </div>
              <div class="flex items-center gap-1.5">
                <img src="/assets/illustrations/carga-v2.svg" class="w-7 h-7" alt="" />
                <button data-goto="cs-card-3" class="cursor-pointer text-xs font-bold text-primary-500 hover:text-accent-500 transition-colors uppercase underline-offset-4 hover:underline">Capacidade de Carga</button>
              </div>
            </div></div>
    </div>
  </div>
  <div id="cs-card-3" data-cadeira-card class="bg-surface p-6 rounded-lg shadow-card border border-border hover:-translate-y-0.5 hover:border-ink/30 hover:shadow-elevation-3 transition-all duration-300 ease-in-out relative overflow-visible w-full">
    <div class="flex h-full gap-4 items-stretch">
      <div class="w-[393px] max-w-full flex-shrink-0 self-stretch">
        <div data-card-toggle class="cursor-pointer" role="button" tabindex="0" aria-label="Abrir detalhes da Cadeira Suspensa 3">
        <HeroCurveSlider
      slides={[
        { src: '/assets/cadeira-suspensa/007.webp', alt: 'Cadeira Suspensa 3 - vista 1' },
        { src: '/assets/cadeira-suspensa/008.webp', alt: 'Cadeira Suspensa 3 - vista 2' },
      ]}
      label="Galeria 3"
      autoplayMs={3500}
      idPrefix="cs3"
    />
        </div>
    <h3 id="cs3-h3" class="cs-card-title-source font-display text-xl font-bold mb-2 text-ink transition-all duration-300">Capacidade de Carga</h3>
    <p id="cs3-desc" class="cs-card-subtitle-source text-text-secondary mb-4 transition-all duration-300">Suporte robusto para operador e equipamentos</p>
    <Button variant="secondary" size="sm" data-card-toggle class="cs-card-button-source">Ver detalhes</Button>
    </div>
    <div class="h-full w-full bg-surface-alt rounded-lg p-4 relative overflow-hidden cs-card-details" aria-hidden="true"><h3 class="absolute inset-x-4 top-4 m-0 font-display text-xl font-bold text-ink cs-card-title-detail">Capacidade de Carga</h3><p class="absolute inset-x-4 top-12 m-0 text-text-secondary cs-card-subtitle-detail">Suporte robusto para operador e equipamentos</p><p class="absolute inset-x-4 top-24 bottom-16 m-0 text-sm font-medium text-ink leading-relaxed cs-card-details-text">Desenvolvida para suportar com total segurança uma carga máxima operacional de até 140 kg. Este limite contempla a soma do peso do profissional operador, somado a todas as ferramentas, EPIs obrigatórios e materiais de trabalho, garantindo absoluta estabilidade durante o uso e total aderência às mais exigentes normas regulamentadoras de segurança.</p><Button variant="secondary" size="sm" data-card-toggle class="cs-card-button-detail absolute left-4 bottom-4">Ver detalhes</Button>
            <div class="cs-quick-nav absolute right-4 bottom-4 flex items-center gap-5 opacity-0 transition-opacity duration-300">
              <span class="text-[10px] font-bold text-text-secondary uppercase tracking-widest whitespace-nowrap">Ir para:</span>
              <div class="flex items-center gap-1.5">
                <img src="/assets/illustrations/uso-v2.svg" class="w-7 h-7" alt="" />
                <button data-goto="cs-card-1" class="cursor-pointer text-xs font-bold text-primary-500 hover:text-accent-500 transition-colors uppercase underline-offset-4 hover:underline">Indicação de Uso</button>
              </div>
              <div class="flex items-center gap-1.5">
                <img src="/assets/illustrations/manutencao-v2.svg" class="w-7 h-7" alt="" />
                <button data-goto="cs-card-2" class="cursor-pointer text-xs font-bold text-primary-500 hover:text-accent-500 transition-colors uppercase underline-offset-4 hover:underline">Manutenção e Inspeção</button>
              </div>
            </div></div>
    </div>
    </div>
  </div>

<Section id="cadeira-suspensa-cta" size="none" tone="surface" class="mb-12 mt-12">
  <div class="mx-auto max-w-5xl rounded-lg bg-surface-alt px-4 py-16 text-ink md:px-8 md:py-20">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="mb-6 font-display text-3xl font-extrabold text-accent-500 md:text-5xl">
        Sua cadeira suspensa certificada começa aqui
      </h2>
      <p class="mb-8 font-body text-lg leading-relaxed text-text-secondary">
        Garanta equipamento com CA válido, rastreabilidade total e suporte técnico especializado.
        Fale com nossos especialistas para orçamento e condições.
      </p>
      <div class="flex flex-col justify-center gap-4 sm:flex-row">
        <Button
          id="cadeira-quote-cta"
          variant="primary"
          size="lg"
          as="a"
          href="/contato/"
          class="bg-accent-500 text-ink hover:bg-accent-600 active:bg-accent-600"
        >
          Solicitar Orçamento
          <LordIcon
            src="/lordicon/system-outline-3104-thumbs-up-down-hover-pinch.json"
            trigger="hover"
            state="hover-pinch"
            target="#cadeira-quote-cta"
            currentColor
            class="h-5 w-5 shrink-0"
          />
        </Button>
        <Button
          id="cadeira-whatsapp-cta"
          variant="secondary"
          size="lg"
          as="a"
          href="https://wa.me/551155622727?text=Olá, gostaria de orçamento para Cadeira Suspensa"
        >
          Falar no WhatsApp
          <LordIcon
            src="/lordicon/system-outline-4073-email-hover-pinch.json"
            trigger="hover"
            state="hover-pinch"
            target="#cadeira-whatsapp-cta"
            class="h-5 w-5 shrink-0"
          />
        </Button>
      </div>
    </div>
  </div>
</Section>
<FibramferFloat asset="f2" />
<style>
  .cs-card-details { display: none; }
  .cs-card-title-source { transition: opacity 0.35s ease-out, transform 0.35s ease-out; }
  .cs-card-title-source--hidden { opacity: 0; transform: translateY(-24px); }
  .cs-card-title-detail { opacity: 0; transform: translateY(-24px); transition: opacity 0.35s ease-out, transform 0.35s ease-out; }
  .cs-card-title-detail--visible { opacity: 1; transform: translateY(0); }
  .cs-card-subtitle-source { transition: opacity 0.35s ease-out, transform 0.35s ease-out; }
  .cs-card-subtitle-source--hidden { opacity: 0; transform: translateY(-24px); }
  .cs-card-subtitle-detail { opacity: 0; transform: translateY(-24px); transition: opacity 0.35s ease-out, transform 0.35s ease-out; }
  .cs-card-subtitle-detail--visible { opacity: 1; transform: translateY(0); }
  .cs-card-button-source { transition: opacity 0.35s ease-out, transform 0.35s ease-out; }
  .cs-card-button-source--hidden { opacity: 0; transform: translateY(-24px); }
  .cs-card-button-detail { opacity: 0; transform: translateY(-24px); transition: opacity 0.35s ease-out, transform 0.35s ease-out; }
  .cs-card-button-detail--visible { opacity: 1; transform: translateY(0); }
  .cs-quick-nav--visible { opacity: 1 !important; }
  .cs-card-source--collapsed { max-height: 0; margin-bottom: 0; overflow: hidden; }
  .cs-card-details-text { opacity: 0; transform: translateY(-24px); transition: opacity 0.35s ease-out, transform 0.35s ease-out; }
  .cs-card-details-text--visible { opacity: 1; transform: translateY(0); }
  :global(#cs-card-1 [data-hero-curve-slider]), :global(#cs-card-2 [data-hero-curve-slider]), :global(#cs-card-3 [data-hero-curve-slider]) { transition: height 0.35s ease-out; will-change: height; }
  .cs-top { z-index: 4 !important; }
  #cs-card-1 { position: relative; z-index: 1; transition: width 0.5s ease-in-out, box-shadow 0.3s ease; will-change: width; }
  #cs-card-1.cs-expanded { width: calc(300% + 4rem); }
  #cs-card-2 { position: relative; z-index: 2; transition: width 0.5s ease-in-out, box-shadow 0.3s ease, margin-left 0.5s ease-in-out; will-change: width, margin-left; }
  #cs-card-2.cs-expanded { width: calc(300% + 4rem); margin-left: calc(-100% - 2rem); }
  #cs-card-3 { position: relative; z-index: 3; transition: width 0.5s ease-in-out, box-shadow 0.3s ease, margin-left 0.5s ease-in-out; will-change: width, margin-left; }
  #cs-card-3.cs-expanded { width: calc(300% + 4rem); margin-left: calc(-200% - 4rem); }
</style>
<script>
  const CARD_REVEAL_DELAY_MS = 500;
  const CARD_STAGGER_MS = 150;
  const CARD_FADE_MS = 350;
  const CARD_CONTENT_EXIT_DURATION_MS = CARD_STAGGER_MS * 3 + CARD_FADE_MS;
  const CARD_WIDTH_TRANSITION_MS = 500;
  const CARD_SLIDER_TRANSITION_MS = 350;
  const CARD_SLIDER_HEIGHT_RATIO = 700 / 1179;
  const cardAnimationTimers = new WeakMap<HTMLElement, number[]>();

  function clearCardAnimationTimers(details: HTMLElement): void {
    cardAnimationTimers.get(details)?.forEach((timer) => window.clearTimeout(timer));
    cardAnimationTimers.delete(details);
  }

  function scheduleCardAnimation(details: HTMLElement, callback: () => void, delay: number): void {
    const timer = window.setTimeout(callback, delay);
    const timers = cardAnimationTimers.get(details) ?? [];
    timers.push(timer);
    cardAnimationTimers.set(details, timers);
  }

  function expandCadeiraSlider(card: HTMLElement, details: HTMLElement): void {
    const slider = card.querySelector<HTMLElement>('[data-hero-curve-slider]');
    const currentHeight = slider?.getBoundingClientRect().height ?? 0;
    const targetHeight = details.getBoundingClientRect().height;
    if (!slider || !currentHeight || !targetHeight) return;

    details.style.height = `${targetHeight}px`;
    slider.classList.add('cs-card-slider--expanded');
    slider.style.aspectRatio = 'auto';
    slider.style.height = `${currentHeight}px`;
    requestAnimationFrame(() => {
      slider.style.height = `${targetHeight}px`;
    });
  }

  function collapseCadeiraSlider(card: HTMLElement, details: HTMLElement): void {
    const slider = card.querySelector<HTMLElement>('[data-hero-curve-slider]');
    const currentHeight = slider?.getBoundingClientRect().height ?? 0;
    const targetWidth = slider?.getBoundingClientRect().width ?? 0;
    if (!slider || !currentHeight || !targetWidth) return;

    const targetHeight = targetWidth * CARD_SLIDER_HEIGHT_RATIO;
    slider.classList.remove('cs-card-slider--expanded');
    slider.style.aspectRatio = 'auto';
    slider.style.height = `${currentHeight}px`;
    details.style.removeProperty('height');
    requestAnimationFrame(() => {
      slider.style.height = `${targetHeight}px`;
    });
    window.setTimeout(() => {
      slider.style.removeProperty('height');
      slider.style.removeProperty('aspect-ratio');
    }, CARD_SLIDER_TRANSITION_MS);
  }

  function toggleCadeiraCard(card: HTMLElement): void {
    const details = card.querySelector<HTMLElement>('.cs-card-details');
    const titleSource = card.querySelector<HTMLElement>('.cs-card-title-source');
    const titleDetail = card.querySelector<HTMLElement>('.cs-card-title-detail');
    const subtitleSource = card.querySelector<HTMLElement>('.cs-card-subtitle-source');
    const subtitleDetail = card.querySelector<HTMLElement>('.cs-card-subtitle-detail');
    const detailText = card.querySelector<HTMLElement>('.cs-card-details-text');
    const buttonSource = card.querySelector<HTMLElement>('.cs-card-button-source');
    const buttonDetail = card.querySelector<HTMLElement>('.cs-card-button-detail');
    const opening = !card.classList.contains('cs-expanded');

    if (details) {
      clearCardAnimationTimers(details);
      if (opening) {
        titleSource?.classList.remove('cs-card-title-source--hidden');
        titleDetail?.classList.remove('cs-card-title-detail--visible');
        subtitleSource?.classList.remove('cs-card-subtitle-source--hidden');
        subtitleDetail?.classList.remove('cs-card-subtitle-detail--visible');
        detailText?.classList.remove('cs-card-details-text--visible');
        buttonSource?.classList.remove('cs-card-button-source--hidden');
        buttonDetail?.classList.remove('cs-card-button-detail--visible');
        titleSource?.classList.remove('cs-card-source--collapsed');
        subtitleSource?.classList.remove('cs-card-source--collapsed');
        buttonSource?.classList.remove('cs-card-source--collapsed');
        details.style.display = 'none';
        details.setAttribute('aria-hidden', 'true');
      } else {
        details.style.display = 'block';
        details.removeAttribute('aria-hidden');
      }
    }

    if (opening) card.classList.add('cs-top');

    if (opening) {
      window.setTimeout(() => {
        card.classList.add('cs-expanded');
        card.querySelectorAll<HTMLButtonElement>('button[data-card-toggle]').forEach((button) => {
          button.innerText = 'Ocultar detalhes';
        });

        if (!details) return;

        details.style.display = 'block';
        scheduleCardAnimation(details, () => {
          titleSource?.classList.add('cs-card-title-source--hidden');
          titleDetail?.classList.add('cs-card-title-detail--visible');
        }, CARD_REVEAL_DELAY_MS);
        scheduleCardAnimation(details, () => {
          subtitleSource?.classList.add('cs-card-subtitle-source--hidden');
          subtitleDetail?.classList.add('cs-card-subtitle-detail--visible');
        }, CARD_REVEAL_DELAY_MS + CARD_STAGGER_MS);
        scheduleCardAnimation(details, () => {
          detailText?.classList.add('cs-card-details-text--visible');
        }, CARD_REVEAL_DELAY_MS + CARD_STAGGER_MS * 2);
        scheduleCardAnimation(details, () => {
          buttonSource?.classList.add('cs-card-button-source--hidden');
          buttonDetail?.classList.add('cs-card-button-detail--visible');
          expandCadeiraSlider(card, details);
          card.querySelector('.cs-quick-nav')?.classList.add('cs-quick-nav--visible');
          titleSource?.classList.add('cs-card-source--collapsed');
          subtitleSource?.classList.add('cs-card-source--collapsed');
          buttonSource?.classList.add('cs-card-source--collapsed');
          details.removeAttribute('aria-hidden');
        }, CARD_REVEAL_DELAY_MS + CARD_STAGGER_MS * 3);
      }, 50);
      return;
    }

    card.querySelectorAll<HTMLButtonElement>('button[data-card-toggle]').forEach((button) => {
      button.innerText = 'Ver detalhes';
    });

    if (details) {
      // Keep the yellow box mounted while its contents leave, then start the
      // card contraction only after the last element has finished moving out.
      scheduleCardAnimation(details, () => {
        buttonSource?.classList.remove('cs-card-button-source--hidden');
        buttonDetail?.classList.remove('cs-card-button-detail--visible');
        buttonSource?.classList.remove('cs-card-source--collapsed');
      }, 0);
      scheduleCardAnimation(details, () => {
        detailText?.classList.remove('cs-card-details-text--visible');
      }, CARD_STAGGER_MS);
      scheduleCardAnimation(details, () => {
        subtitleSource?.classList.remove('cs-card-subtitle-source--hidden');
        subtitleDetail?.classList.remove('cs-card-subtitle-detail--visible');
        subtitleSource?.classList.remove('cs-card-source--collapsed');
      }, CARD_STAGGER_MS * 2);
      scheduleCardAnimation(details, () => {
        titleSource?.classList.remove('cs-card-title-source--hidden');
        titleDetail?.classList.remove('cs-card-title-detail--visible');
        titleSource?.classList.remove('cs-card-source--collapsed');
      }, CARD_STAGGER_MS * 3);
      scheduleCardAnimation(details, () => {
        collapseCadeiraSlider(card, details);
        card.classList.remove('cs-expanded');
      }, CARD_CONTENT_EXIT_DURATION_MS);
      card.querySelector('.cs-quick-nav')?.classList.remove('cs-quick-nav--visible');
        scheduleCardAnimation(details, () => {
          details.style.display = 'none';
          details.setAttribute('aria-hidden', 'true');
          card.classList.remove('cs-top');
          clearCardAnimationTimers(details);
        }, CARD_CONTENT_EXIT_DURATION_MS + CARD_WIDTH_TRANSITION_MS);
      return;
    }

    window.setTimeout(() => {
      card.classList.remove('cs-expanded');
      window.setTimeout(() => card.classList.remove('cs-top'), CARD_WIDTH_TRANSITION_MS);
    }, 50);
  }

  function cardToggleFromTarget(target: EventTarget | null): HTMLElement | null {
    if (!(target instanceof Element)) return null;
    const trigger = target.closest<HTMLElement>('[data-card-toggle]');
    return trigger?.closest<HTMLElement>('[data-cadeira-card]') ?? null;
  }

  function switchToCard(targetId: string) {
    const current = document.querySelector<HTMLElement>('[data-cadeira-card].cs-expanded');
    const target = document.querySelector<HTMLElement>(`#${targetId}`);
    if (!target) return;
    if (current && current !== target) {
      toggleCadeiraCard(current);
      window.setTimeout(() => toggleCadeiraCard(target), CARD_CONTENT_EXIT_DURATION_MS + CARD_WIDTH_TRANSITION_MS + 50);
    } else {
      toggleCadeiraCard(target);
    }
  }

  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof HTMLElement)) return;
    const gotoBtn = target.closest<HTMLButtonElement>('[data-goto]');
    if (gotoBtn) {
      event.preventDefault();
      const targetId = gotoBtn.getAttribute('data-goto');
      if (targetId) switchToCard(targetId);
      return;
    }
    const card = cardToggleFromTarget(event.target);
    if (card) toggleCadeiraCard(card);
