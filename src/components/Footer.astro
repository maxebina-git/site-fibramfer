---
import { Footer as DSFooter } from 'ds-grupo-rkb';
import { sitePath } from '../lib/sitePath';

const companyInfo = {
  companyName: 'Fibramfer',
  legalLinks: [
    { label: 'Privacidade', href: sitePath('/privacidade') },
    { label: 'Termos', href: sitePath('/termos') },
  ],
};

const copyright = `© ${new Date().getFullYear()} Fibramfer. Todos os direitos reservados.`;
---

<DSFooter size="lg" padding="sm" showColumns={false} compactInfo align="left" {companyInfo} {copyright} />
