---
import rawSvg from '../assets/cadeira-suspensa-outline.svg?raw';

const chairDrawSvg = rawSvg
  .replace(/\s(?:width|height)="[^"]*"/g, '')
  .replace(/stroke="black"/g, 'stroke="currentColor"')
  .replace(
    '<svg',
    '<svg class="chair-draw-svg" data-chair-draw="pending" aria-hidden="true" focusable="false"'
  );
---

<div class="chair-draw-root" set:html={chairDrawSvg} />

<div class="chair-draw-fill" data-chair-draw-fill aria-hidden="true">
  <img src="/assets/cadeira-suspensa-no-bg.png" alt="" loading="eager" />
</div>

<noscript>
  <style>
    [data-chair-draw='pending'] path {
      stroke-dashoffset: 0 !important;
    }
  </style>
</noscript>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const svg = document.querySelector<SVGElement>('svg[data-chair-draw]');

  if (svg && svg.dataset.drawReady !== 'true') {
    svg.dataset.drawReady = 'true';

    const paths = Array.from(svg.querySelectorAll<SVGPathElement>('path'));
    const fill = document.querySelector<HTMLElement>('[data-chair-draw-fill]');
    const track = document.querySelector<HTMLElement>('[data-home-scroll-track]');
    const drawerShell = document.querySelector<HTMLElement>('[data-fibramfer-drawers]');
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let drawTimeline: ReturnType<typeof gsap.timeline> | null = null;
    let scrollTimeline: ReturnType<typeof gsap.timeline> | null = null;
    let homeChromeResizeHandler: (() => void) | null = null;
    let drawerOpen = Boolean(drawerShell?.querySelector('aside[role="dialog"]'));
    let replayAfterDrawer = false;
    let replayScrollStart: number | null = null;

    const publishChairProgress = (progress: number) => {
      const normalized = Math.min(1, Math.max(0, progress));
      document.documentElement.style.setProperty('--fibramfer-chair-progress', String(normalized));
      window.dispatchEvent(new CustomEvent('fibramfer:chair-progress', {
        detail: { progress: normalized },
      }));
    };

    publishChairProgress(0);

    // O replay usa a posição atual como início, sem mover a página. Se o
    // usuário voltar antes desse ponto (inclusive após fechar no fim da home),
    // a próxima descida pode revelar a cadeira a partir dessa nova posição.
    const rebaseReplayScroll = () => {
      if (replayScrollStart === null || window.scrollY >= replayScrollStart) return;
      replayScrollStart = window.scrollY;
      scrollTimeline?.scrollTrigger?.refresh();
    };

    const releaseFillOnScroll = () => {
      if (!fill || drawerOpen) return;

      if (prefersReducedMotion.matches) {
        publishChairProgress(1);
        gsap.set(fill, { '--chair-reveal-front': '118%' });
        gsap.set(svg, { opacity: 0 });
        return;
      }

      if (!track || fill.dataset.scrollReady === 'true') return;
      fill.dataset.scrollReady = 'true';
      replayScrollStart = replayAfterDrawer ? window.scrollY : null;
      publishChairProgress(0);

      scrollTimeline = gsap
        .timeline({
          defaults: { ease: 'none' },
          onUpdate: () => publishChairProgress(scrollTimeline?.progress() ?? 0),
          scrollTrigger: {
            trigger: track,
            start: () => {
              if (replayScrollStart !== null) return replayScrollStart;
              const header = document.querySelector<HTMLElement>('header');
              const headerHeight = header?.getBoundingClientRect().height ?? 0;
              return `top top+=${headerHeight}`;
            },
            end: () => {
              if (replayScrollStart !== null) {
                return Math.max(replayScrollStart + 1, ScrollTrigger.maxScroll(window));
              }
              const footer = document.querySelector<HTMLElement>('body.home-page > footer');
              const footerHeight = footer?.getBoundingClientRect().height ?? 0;
              return `bottom bottom-=${footerHeight}`;
            },
            scrub: 1,
            invalidateOnRefresh: true,
          },
        })
        .fromTo(
          fill,
          { '--chair-reveal-front': '0%' },
          { '--chair-reveal-front': '118%', duration: 1 },
          0
        )
        .to(svg, { opacity: 0, duration: 0.5 }, 0.5);

      if (replayAfterDrawer) {
        window.addEventListener('scroll', rebaseReplayScroll, { passive: true });
      }
      homeChromeResizeHandler = () => ScrollTrigger.refresh();
      window.addEventListener('fibramfer:home-chrome-resize', homeChromeResizeHandler);
      window.requestAnimationFrame(() => ScrollTrigger.refresh());
    };

    const showComplete = () => {
      for (const path of paths) {
        path.style.removeProperty('stroke-dasharray');
        path.style.removeProperty('stroke-dashoffset');
      }
      svg.setAttribute('data-chair-draw', 'done');
      releaseFillOnScroll();
    };

    let started = false;

    const start = () => {
      if (drawerOpen || started || svg.getClientRects().length === 0) return;
      started = true;

      if (prefersReducedMotion.matches || paths.length === 0) {
        showComplete();
        return;
      }

      const items = paths
        .map((path) => ({ path, length: path.getTotalLength() }))
        .sort((a, b) => b.length - a.length);

      const structureMinLength = 25;
      const structure = items.filter((item) => item.length >= structureMinLength);
      const details = items.filter((item) => item.length < structureMinLength);

      drawTimeline = gsap.timeline({ onComplete: showComplete });
      const DRAW_SPEED = 1 / 3;
      let position = 0.4 * DRAW_SPEED;

      for (const { path, length } of structure) {
        const duration = gsap.utils.clamp(0.35, 1.25, length / 1150) * DRAW_SPEED;
        drawTimeline.to(path, { strokeDashoffset: 0, duration, ease: 'power2.inOut' }, position);
        position += duration * 0.5;
      }

      if (details.length > 0) {
        drawTimeline.to(
          details.map((item) => item.path),
          { strokeDashoffset: 0, duration: 0.2 * DRAW_SPEED, ease: 'power1.out', stagger: 0.026 * DRAW_SPEED },
          position + 0.05 * DRAW_SPEED
        );
      }
    };

      const reset = () => {
        drawTimeline?.kill();
        drawTimeline = null;

        if (scrollTimeline) {
          scrollTimeline.scrollTrigger?.kill();
          scrollTimeline.kill();
          scrollTimeline = null;
        }

        window.removeEventListener('scroll', rebaseReplayScroll);
        replayScrollStart = null;
        publishChairProgress(0);

        if (homeChromeResizeHandler) {
          window.removeEventListener('fibramfer:home-chrome-resize', homeChromeResizeHandler);
          homeChromeResizeHandler = null;
        }

        paths.forEach((path) => {
          const length = path.getTotalLength();
          path.style.strokeDasharray = String(length);
          path.style.strokeDashoffset = String(length);
        });

        svg.setAttribute('data-chair-draw', 'pending');
        gsap.set(svg, { opacity: 1 });
        if (fill) {
          fill.removeAttribute('data-scroll-ready');
          gsap.set(fill, { '--chair-reveal-front': '0%' });
        }

        started = false;
      };

      // O painel permanece no DOM até o fim da saída do DS. Observar somente
      // sua presença mantém a cadeira parada também nas trocas de conteúdo e
      // nas saídas canceladas por uma reabertura rápida, sem timers paralelos.
      const drawerObserver = new MutationObserver(() => {
        const open = Boolean(drawerShell?.querySelector('aside[role="dialog"]'));
        if (open === drawerOpen) return;
        drawerOpen = open;
        reset();
        if (!open) {
          replayAfterDrawer = true;
          start();
        }
      });

      if (drawerShell) {
        drawerObserver.observe(drawerShell, { childList: true, subtree: true });
      }

      if (drawerOpen) reset();
      else start();

    const desktopQuery = window.matchMedia('(min-width: 768px)');
    desktopQuery.addEventListener('change', start);
  }
</script>
