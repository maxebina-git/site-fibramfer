---
import BaseLayout from '../../layouts/BaseLayout.astro';


const { slug } = Astro.params;
let post = null;
try {
  const res = await fetch('/api/admin.php?action=list');
  const data = await res.json();
  if (data.posts) post = data.posts.find((p: any) => p.id === slug);
} catch {}
---

<BaseLayout title={post ? `${post.title} | Fibramfer` : 'Post | Fibramfer'}>
  <main class="max-w-3xl mx-auto px-6 py-12">
    {post ? (
      <article>
        <header class="mb-8">
          <h1 class="font-display text-4xl">{post.title}</h1>
          <p class="text-text-secondary text-sm mt-2">{post.date} · {post.category}</p>
        </header>
        <div class="prose text-ink">
          {post.content}
        </div>
      </article>
    ) : (
      <p>Post não encontrado.</p>
    )}
  </main>
</BaseLayout>
