---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import FibramferDrawers from '../../components/FibramferDrawers.astro';

let posts = [];
try {
  const res = await fetch('/api/admin.php?action=list');
  const data = await res.json();
  if (data.posts) posts = data.posts;
} catch {
  // fallback vazio
}
---

<BaseLayout title="Blog | Fibramfer">
  <FibramferDrawers />
  <main class="max-w-3xl mx-auto px-6 py-12">
    <h1 class="font-display text-4xl mb-8">Blog</h1>
    <div class="grid gap-6">
      {posts.map((p: any) => (
        <BlogCard
          title={p.title}
          subtitle={p.category}
          date={p.date}
          image={p.image}
          href={`/blog/${p.id}`}
        />
      ))}
      {posts.length === 0 && <p class="text-text-secondary">Nenhum post encontrado.</p>}
    </div>
  </main>
</BaseLayout>
