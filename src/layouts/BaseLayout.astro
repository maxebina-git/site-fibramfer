---
import '../css/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  home?: boolean;
}

const { title = 'Site Fibramfer', description, home = false } = Astro.props;

const panelRoutes = ['/a-fibramfer', '/cadeira-suspensa', '/onde-comprar', '/seguranca', '/blog', '/contato', '/privacidade', '/termos'];
const legalRoutes = ['/privacidade', '/termos'];
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isRouteActive = (route: string): boolean =>
  currentPath === route || currentPath.startsWith(`${route}/`);
const isPanelOpen = panelRoutes.some(isRouteActive);
const isLegalOpen = legalRoutes.some(isRouteActive);
---

<!DOCTYPE html>
<html lang="pt-BR" class="home-page">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" href="https://fonts.gstatic.com/s/barlowcondensed/v13/HTxwL3I-JCGChYJ8VI-L6OO_au7B47b1z3bWuQ.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="https://fonts.gstatic.com/s/inter/v20/UcCO3FwrK3iLTeHuS_nVMrMxCp50SjIw2boKoduKmMEVuLyfAZ9hiA.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="https://fonts.gstatic.com/s/inter/v20/UcC73FwrK3iLTeHuS_nVMrMxCp50SjIa1ZL7.woff2" as="font" type="font/woff2" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;600;700;800;900&family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=optional" rel="stylesheet" />
  </head>
  <body data-theme="fibramfer" class="home-page min-h-screen flex flex-col"
    data-panel-drawer-open={isPanelOpen ? 'true' : undefined}
    data-legal-drawer={isLegalOpen ? 'true' : undefined}
    data-fibramfer-initializing={isPanelOpen ? 'true' : undefined}
    data-fibramfer-direct-drawer={isPanelOpen ? 'true' : undefined}
  >
    <script>
      (function () {
        const titles = {
          '/': 'Site Fibramfer',
          '/a-fibramfer': 'A Fibramfer',
          '/cadeira-suspensa': 'Cadeira Suspensa',
          '/onde-comprar': 'Onde Comprar',
          '/seguranca': 'Segurança',
          '/blog': 'Blog',
          '/contato': 'Contato',
        };
        function update() {
          const path = window.location.pathname.replace(/\/$/, '') || '/';
          if (titles[path]) document.title = titles[path] + ' | Fibramfer';
        }
        update();
        window.addEventListener('popstate', update);
        setInterval(update, 800);
      })();
    </script>
    <Header />
    <main class="home-main flex min-h-0 flex-1 flex-col w-full">
      <slot />
    </main>
    <Footer />
  </body>
</html>
