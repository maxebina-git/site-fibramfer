---
import '../css/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_BASE, SITE_ORIGIN, sitePath, stripSiteBase } from '../lib/sitePath';
import { isDrawerPanelPath, isLegalDrawerPath } from '../lib/drawerRoutes';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: string;
}

const { title = 'Site Fibramfer', description, image, type = 'website' } = Astro.props;
const DEFAULT_DESCRIPTION = 'Soluções em fibra de vidro e resina para construção civil e indústria — Fibramfer.';
const finalDescription = description || DEFAULT_DESCRIPTION;
const canonicalPath = (stripSiteBase(Astro.url.pathname) || '/').replace(/\/+$/, '') + '/';
const canonicalUrl = `${SITE_ORIGIN}${sitePath(canonicalPath)}`;
const finalImage = image
  ? (/^https?:\/\//.test(image) ? image : `${SITE_ORIGIN}${sitePath(image)}`)
  : undefined;

const isPanelOpen = isDrawerPanelPath(Astro.url.pathname);
const isLegalOpen = isLegalDrawerPath(Astro.url.pathname);
---

<!DOCTYPE html>
<html lang="pt-BR" class="home-page">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={finalDescription} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={finalDescription} />
    <meta property="og:site_name" content="Fibramfer" />
    <meta property="og:locale" content="pt_BR" />
    {finalImage && <meta property="og:image" content={finalImage} />}
    <meta name="twitter:card" content={finalImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={finalDescription} />
    {finalImage && <meta name="twitter:image" content={finalImage} />}
    <link rel="icon" type="image/svg+xml" href={sitePath('/favicon.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" href="https://fonts.gstatic.com/s/barlowcondensed/v13/HTxwL3I-JCGChYJ8VI-L6OO_au7B47b1z3bWuQ.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="https://fonts.gstatic.com/s/inter/v20/UcCO3FwrK3iLTeHuS_nVMrMxCp50SjIw2boKoduKmMEVuLyfAZ9hiA.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="https://fonts.gstatic.com/s/inter/v20/UcC73FwrK3iLTeHuS_nVMrMxCp50SjIa1ZL7.woff2" as="font" type="font/woff2" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;600;700;800;900&family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
  </head>
  <body data-theme="fibramfer" data-site-base={SITE_BASE} class="home-page min-h-screen flex flex-col"
    data-panel-drawer-open={isPanelOpen ? 'true' : undefined}
    data-legal-drawer={isLegalOpen ? 'true' : undefined}
    data-fibramfer-initializing={isPanelOpen ? 'true' : undefined}
    data-fibramfer-direct-drawer={isPanelOpen ? 'true' : undefined}
  >
    <script>
      import { stripSiteBase } from '../lib/sitePath';

      (function () {
        const titles: Record<string, string> = {
          '/': 'Fibramfer | Especialistas em Fibra',
          '/a-fibramfer': 'A Fibramfer',
          '/cadeira-suspensa': 'Cadeira Suspensa',
          '/admin': 'Admin',
          '/seguranca': 'Segurança',
          '/blog': 'Blog',
          '/contato': 'Contato',
        };
        let titleInterval: ReturnType<typeof setInterval> | null = null;
        function startTitleSync(): void {
          stopTitleSync();
          titleInterval = setInterval(update, 800);
        }
        function stopTitleSync(): void {
          if (titleInterval !== null) {
            clearInterval(titleInterval);
            titleInterval = null;
          }
        }
        function update() {
          const path = stripSiteBase(window.location.pathname).replace(/\/$/, '') || '/';
          if (titles[path]) document.title = titles[path] + ' | Fibramfer';
        }
        update();
        window.addEventListener('popstate', update);
        startTitleSync();
        document.addEventListener('visibilitychange', () => {
          if (document.hidden) stopTitleSync();
          else startTitleSync();
        });
      })();
    </script>
    <Header />
    <main class="home-main flex min-h-0 flex-1 flex-col w-full">
      <slot />
    </main>
    <Footer />
    <script type="module">
      import { defineElement } from '@lordicon/element'
      defineElement()
    </script>
  </body>
</html>
